{"seq": 5, "id": "ev-0005", "timestamp": "2026-09-18T13:19:53Z", "iteration": "2026-09-18 初版", "phase": "P1", "task": null, "type": "requirements.updated", "actor": {"kind": "human"}, "summary": "要求 Spec の要件（REQ）と性質（PROP）を登録した", "payload": {"requirements": [{"id": "REQ-001", "title": "締め日は取引先ごとに決まる", "detail": "月末締め / 20日締め のいずれか。請求対象期間は前回締め日の翌日〜今回締め日"}, {"id": "REQ-002", "title": "支払期日は締め日＋支払サイト", "detail": "翌月末 / 翌々月末。支払期日は締め日以降"}, {"id": "REQ-003", "title": "取引先ごとに1請求へ集約", "detail": "対象期間の売上を取引先単位で1件の請求にまとめる"}, {"id": "REQ-004", "title": "税率区分ごとに対価の額を区分", "detail": "標準税率10% と 軽減税率8% を区分して集計・記載する"}, {"id": "REQ-005", "title": "端数処理は請求単位・税率ごとに1回", "detail": "明細ごとに消費税を計算して端数処理し合計することは行わない（※1）"}, {"id": "REQ-006", "title": "適格請求書の記載事項を出力", "detail": "発行者の登録番号、取引年月日、取引内容（軽減税率対象である旨）、税率ごとの対価の額と消費税額、交付先の名称"}, {"id": "REQ-007", "title": "確定済みの請求は変更不可", "detail": "確定後の再締め・金額変更を拒否する"}, {"id": "REQ-008", "title": "対象売上が無ければ請求を作らない", "detail": "期間内に売上が1件も無い取引先には請求を作成しない"}, {"id": "REQ-009", "title": "会計連携は税率ごとの内訳行を持つ", "detail": "請求ヘッダ1行＋税率区分ごとの明細行"}, {"id": "REQ-010", "title": "締め処理を監査記録", "detail": "実行日時・操作者・対象年月・作成件数を記録する"}], "properties": [{"id": "PROP-001", "requirements": ["REQ-003"], "property": "任意の売上集合について、請求の税抜合計 = 明細の税抜金額の総和"}, {"id": "PROP-002", "requirements": ["REQ-005"], "property": "任意の明細集合について、税率ごとの消費税額 = floor(税率ごとの税抜合計 × 税率)。**明細ごとに丸めた額の総和とは一致しないことがある**"}, {"id": "PROP-003", "requirements": ["REQ-004"], "property": "任意の請求について、税率ごとの対価の額の総和 = 請求の税抜合計"}, {"id": "PROP-004", "requirements": ["REQ-002"], "property": "任意の締め日と支払サイトについて、支払期日 ≥ 締め日"}, {"id": "PROP-005", "requirements": ["REQ-003", "REQ-008"], "property": "任意の売上集合について、作成される請求は取引先ごとに高々1件であり、売上が0件の取引先には作成されない"}, {"id": "PROP-006", "requirements": ["REQ-007"], "property": "任意の確定済み請求について、いかなる操作の後も合計額は変化しない"}], "added": ["REQ-001", "REQ-002", "REQ-003", "REQ-004", "REQ-005", "REQ-006", "REQ-007", "REQ-008", "REQ-009", "REQ-010"]}, "provenance": "measured", "source": {"kind": "git", "ref": "2b5689f:docs/re