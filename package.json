{
  "name": "j-six-hub",
  "private": true,
  "version": "0.1.0",
  "description": "J-SIX Hub リプレイ型サンプル（実際の AI は動作しません）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "process:fetch": "node scripts/fetch-process.mjs",
    "dev": "npm run process:fetch && vite",
    "build": "npm run process:fetch && vite build",
    "preview": "vite preview",
    "typecheck": "npm run process:fetch && tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run process:fetch && vitest run",
    "coverage": "npm run process:fetch && vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
